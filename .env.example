# Copy to .env (local) and add the same keys in Vercel → Settings → Environment Variables. See docs/SETUP.md.

# ── Supabase (database + file storage) — required in production ────
# Dashboard → Project Settings → API Keys.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Not used by the server today (kept for future client-side features)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_JWKS_URL=
# Public bucket for JD attachments — created automatically on startup
SUPABASE_STORAGE_BUCKET=jd-attachments
# Database connection used ONLY to apply schema migrations automatically
# (before `npm run dev` and `npm run build`). Supabase → Connect →
# "Session pooler" → URI, with your database password filled in.
# Without it, paste pending files from supabase/migrations into the SQL Editor.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Auth (optional) ──────────────────────────────────────────────────
# Signs login sessions. If empty, a key derived from SUPABASE_SECRET_KEY is used.
# Long random string:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Gmail SMTP (password reset + welcome emails) ───────────────────
# Requires 2-Step Verification on the Gmail account, then create an App Password:
# https://myaccount.google.com/apppasswords  (use the 16-char app password, NOT your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=yourname@gmail.com
EMAIL_PASSWORD=abcd efgh ijkl mnop
# Optional display name/address (defaults to "Joblay <EMAIL_USER>")
SMTP_FROM="Joblay <yourname@gmail.com>"
# Inbox that receives Contact-page messages and job reports (defaults to EMAIL_USER)
CONTACT_TO_EMAIL=

# ── Optional free APIs (each feature is off until its keys are set) ──
# Bot protection on register/login/contact/forgot-password — Cloudflare Turnstile (free):
# https://dash.cloudflare.com → Turnstile → Add widget (add your domain + localhost)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# "Paste a JD → auto-fill the form" — Google Gemini free tier:
# https://aistudio.google.com/apikey  (free tier: Google may use inputs to improve its models)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Instant search-engine indexing when jobs change (needs NEXT_PUBLIC_APP_URL = live URL)
# IndexNow (Bing, Yandex, Naver, Seznam): any random 32-char string, e.g. from
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_KEY=
# Google Indexing API (optional): service account JSON → client_email / private_key,
# and add that email as an Owner of your site in Google Search Console.
GOOGLE_INDEXING_CLIENT_EMAIL=
GOOGLE_INDEXING_PRIVATE_KEY=

# ── App ─────────────────────────────────────────────────────────────
# Public URL of the site (email links, sitemap, search pings). Optional on Vercel,
# which provides its production URL automatically; set it for a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
