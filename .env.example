# Copy to .env.local (local) and add the same keys in Vercel → Settings → Environment Variables.

# ── Supabase (database + file storage) — required in production ────
# Dashboard → Project Settings → API Keys. First run supabase/schema.sql in the SQL Editor.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Not used by the server today (kept for future client-side features)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_JWKS_URL=
# Public bucket for JD attachments — created automatically on startup
SUPABASE_STORAGE_BUCKET=jd-attachments

# ── Auth (required in production) ──────────────────────────────────
# Long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Gmail SMTP (password reset + welcome emails) ───────────────────
# Requires 2-Step Verification on the Gmail account, then create an App Password:
# https://myaccount.google.com/apppasswords  (use the 16-char app password, NOT your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM="Joblay <yourname@gmail.com>"
# Inbox that receives Contact-page messages and job reports (defaults to SMTP_USER)
CONTACT_TO_EMAIL=

# ── App ─────────────────────────────────────────────────────────────
# Public URL of the site — used in password-reset email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
