# Copy to .env.local (local) and add the same keys in Vercel → Settings → Environment Variables.

# ── MongoDB Atlas (required in production) ─────────────────────────
# Atlas → Database → Connect → Drivers. Network Access must allow 0.0.0.0/0 for Vercel.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=joblay

# ── Auth (required in production) ──────────────────────────────────
# Long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Gmail SMTP (password reset + welcome emails) ───────────────────
# Requires 2-Step Verification on the Gmail account, then create an App Password:
# https://myaccount.google.com/apppasswords  (use the 16-char app password, NOT your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM="Joblay <yourname@gmail.com>"
# Inbox that receives Contact-page messages and job reports (defaults to SMTP_USER)
CONTACT_TO_EMAIL=

# ── Supabase Storage (optional JD attachments: PDF/DOC/DOCX, max 5 MB) ──
# Supabase → Storage → New bucket "jd-attachments" → mark as Public.
# Supabase → Project Settings → API → Project URL and service_role key (server only, never expose).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=jd-attachments

# ── App ─────────────────────────────────────────────────────────────
# Public URL of the site — used in password-reset email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
